# Copy this file to .env.local and fill in the values from Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Your live website address, e.g. https://oja.ng (no slash at the end)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Your platform name (change any time)
NEXT_PUBLIC_BRAND_NAME=Sella

# Server-only: never expose or commit these values.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
TRANSACTPAY_BASE_URL=https://payment-api-service.transactpay.ai
TRANSACTPAY_PUBLIC_KEY=your-transactpay-public-key
TRANSACTPAY_ENCRYPTION_KEY=your-transactpay-rsa-encryption-key
# Optional HMAC secret if provided by TransactPay for webhook signing.
TRANSACTPAY_WEBHOOK_SECRET=

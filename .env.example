# Copy this file to .env.local and fill in the values from Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Your live website address, e.g. https://oja.ng (no slash at the end)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional custom domain for seller subdomains, e.g. sella.com.ng
NEXT_PUBLIC_STORE_DOMAIN=
# Your platform name (change any time)
NEXT_PUBLIC_BRAND_NAME=Sella
ADMIN_EMAILS=admin@example.com
# Optional server-side AI generation; without this, Sella uses a safe template suggestion.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Server-only: never expose or commit these values.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional dedicated key for encrypting admin-saved payment credentials.
ADMIN_SETTINGS_ENCRYPTION_KEY=
TRANSACTPAY_BASE_URL=https://payment-api-service.transactpay.ai
TRANSACTPAY_PUBLIC_KEY=your-transactpay-public-key
TRANSACTPAY_SECRET_KEY=your-transactpay-secret-key
TRANSACTPAY_ENCRYPTION_KEY=your-transactpay-rsa-encryption-key
# Virtual-account generation requires TRANSACTPAY_PUBLIC_KEY and TRANSACTPAY_ENCRYPTION_KEY.
